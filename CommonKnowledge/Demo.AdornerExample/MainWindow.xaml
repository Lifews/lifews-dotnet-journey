<Window
    x:Class="Demo.AdornerExample.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Demo.AdornerExample"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AdornerDecorator示例"
    Width="800"
    Height="450"
    mc:Ignorable="d">

    <Window.Resources>
        <!--  定义自定义Adorner的样式  -->
        <Style x:Key="HighlightAdornerStyle" TargetType="local:HighlightAdorner">
            <Setter Property="Brush" Value="#40FF0000" />
            <Setter Property="Pen" Value="Red" />
        </Style>

        <Style x:Key="SelectionAdornerStyle" TargetType="local:SelectionAdorner">
            <Setter Property="Brush" Value="#200000FF" />
            <Setter Property="Pen" Value="Blue" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  工具栏  -->
        <StackPanel
            Grid.Row="0"
            Margin="10"
            Orientation="Horizontal">
            <Button
                x:Name="btnAddHighlight"
                Margin="5"
                Click="BtnAddHighlight_Click"
                Content="添加高亮" />
            <Button
                x:Name="btnRemoveHighlight"
                Margin="5"
                Click="BtnRemoveHighlight_Click"
                Content="移除高亮" />
            <Button
                x:Name="btnToggleSelection"
                Margin="5"
                Click="BtnToggleSelection_Click"
                Content="切换选择框" />
            <Button
                x:Name="btnClearAll"
                Margin="5"
                Click="BtnClearAll_Click"
                Content="清除所有" />
            <CheckBox
                x:Name="chkHitTest"
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                Content="装饰器拦截点击"
                IsChecked="False" />
        </StackPanel>

        <!--  主要内容区域 - 使用AdornerDecorator包裹  -->
        <AdornerDecorator x:Name="mainAdornerDecorator" Grid.Row="1">
            <Border
                Margin="10"
                Background="White"
                BorderBrush="Gray"
                BorderThickness="1">
                <StackPanel x:Name="mainContentPanel" Margin="20">

                    <!--  示例文本  -->
                    <TextBlock
                        Margin="0,0,0,20"
                        FontSize="24"
                        FontWeight="Bold"
                        Text="AdornerDecorator示例" />

                    <!--  示例控件1：可以添加装饰的按钮  -->
                    <Button
                        x:Name="decoratedButton"
                        Width="200"
                        Height="40"
                        Margin="0,10"
                        Padding="10"
                        Click="DecoratedButton_Click"
                        Content="可以被装饰的按钮">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="LightGray" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="LightBlue" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!--  示例控件2：文本框  -->
                    <TextBox
                        x:Name="decoratedTextBox"
                        Width="300"
                        Height="30"
                        Margin="0,10"
                        Padding="5"
                        Text="可以被装饰的文本框" />

                    <!--  示例控件3：图片  -->
                    <Image
                        x:Name="decoratedImage"
                        Width="200"
                        Height="150"
                        Margin="0,10">
                        <Image.Source>
                            <DrawingImage>
                                <DrawingImage.Drawing>
                                    <GeometryDrawing>
                                        <GeometryDrawing.Geometry>
                                            <EllipseGeometry
                                                Center="100,75"
                                                RadiusX="80"
                                                RadiusY="70" />
                                        </GeometryDrawing.Geometry>
                                        <GeometryDrawing.Brush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Offset="0" Color="LightGreen" />
                                                <GradientStop Offset="1" Color="DarkGreen" />
                                            </LinearGradientBrush>
                                        </GeometryDrawing.Brush>
                                        <GeometryDrawing.Pen>
                                            <Pen Brush="Green" Thickness="2" />
                                        </GeometryDrawing.Pen>
                                    </GeometryDrawing>
                                </DrawingImage.Drawing>
                            </DrawingImage>
                        </Image.Source>
                    </Image>

                    <!--  信息显示  -->
                    <TextBlock
                        x:Name="infoText"
                        Margin="0,20,0,0"
                        FontStyle="Italic"
                        Foreground="Gray"
                        Text="点击上面的控件可以添加装饰器" />

                </StackPanel>
            </Border>
        </AdornerDecorator>

        <!--  状态栏  -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="statusText" Text="就绪" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="装饰器数量: ">
                    <Run x:Name="adornerCountText" Text="0" />
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>


</Window>

