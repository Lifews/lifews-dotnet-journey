<Window
    x:Class="Demo.ComboBoxBinding.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Demo.ComboBoxBinding"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <local:EnumBindingSource x:Key="enumDataSource" EnumType="{x:Type local:DateOfWeek}" />
        <local:EnumDescriptionConverter x:Key="enumDescriptionConverter" />
    </Window.Resources>

    <StackPanel
        Width="200"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
        <ComboBox ItemsSource="{Binding Source={StaticResource enumDataSource}}" SelectedItem="{Binding DateOfWeek}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding ., Converter={StaticResource enumDescriptionConverter}}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox
            Margin="0,10,0,0"
            IsReadOnly="True"
            Text="{Binding DateOfWeek, Mode=OneWay}" />
    </StackPanel>

</Window>
