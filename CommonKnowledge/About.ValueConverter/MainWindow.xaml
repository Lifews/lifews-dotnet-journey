<ui:FluentWindow
    x:Class="About.ValueConverter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:About.ValueConverter"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="MainWindow"
    Width="960"
    Height="720"
    ui:Design.Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:RgbConverter x:Key="rgbConv" />
    </ui:FluentWindow.Resources>
    <StackPanel>
        <ui:TitleBar Title="{Binding ElementName=UserInputBox, Path=Text, Converter={local:PathToTitleConverter}, FallbackValue='Value Converters'}" />
        <!--
            FallbackValue 是 Binding 自己的“备胎”——
            当绑定无法拿出可用值时（路径错、元素找不到、Converter 抛异常、返回 UnsetValue 等），就把这个备胎值直接塞给属性，防止画面崩掉
            通常配合 Binding.DoNothing 一起用
        -->
        <ui:TextBlock
            Margin="15,0"
            FontTypography="Caption"
            Text="Card Visible" />
        <ui:ToggleSwitch Name="VisibilityToggleSwitch" Margin="15,10" />
        <ui:Card
            Margin="15,10"
            d:Visibility="Visible"
            Visibility="{Binding ElementName=VisibilityToggleSwitch, Path=IsChecked, Converter={StaticResource BoolToVis}}">
            <ui:TextBlock FontTypography="Caption" Text="使用WPF内置的值转换器ValueConverter" />
        </ui:Card>
        <ui:Card
            Margin="15,10"
            d:Visibility="Visible"
            Visibility="{Binding ElementName=VisibilityToggleSwitch, Path=IsChecked, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
            <!--
                x:Static：
                XAML 的 标记扩展，作用就是：
                “把 某个类的 public static 字段 / 属性 / 枚举值 当成 XAML 里的常量拿来用。”
                “别去资源字典里找转换器了，直接用代码里那个现成的单例静态字段。”
                省内存、省代码、编译期安全、零运行时查找成本
                只要你的类确实是“无状态、可复用”的单例，用 x:Static 就是 最轻量、最干净 的写法。
            -->
            <ui:TextBlock FontTypography="Caption" Text="将自定义的Converter声明为单例,并在这里调用" />
        </ui:Card>
        <ui:Card
            Margin="15,10"
            d:Visibility="Visible"
            Visibility="{Binding ElementName=VisibilityToggleSwitch, Path=IsChecked, Converter={StaticResource GlobalBooleanToVisibilityConverter}}">
            <ui:TextBlock FontTypography="Caption" Text="在App.xaml中声明Converter" />
        </ui:Card>
        <ui:Card
            Margin="15,10"
            d:Visibility="Visible"
            Visibility="{Binding ElementName=VisibilityToggleSwitch, Path=IsChecked, Converter={local:BoolToVisibilityMarkupExtension IsReversed=False}}">
            <!--  使用MarkupExtension声明，适合频繁需要定制的Converter  -->
            <ui:TextBlock FontTypography="Caption" Text="使用MarkupExtension" />
        </ui:Card>
        <TextBox Name="UserInputBox" Margin="15,10" />
        <TextBlock
            Width="300"
            Height="33"
            Margin="15,10"
            HorizontalAlignment="Left"
            Text="{Binding ElementName=NumberBox, Path=Value, Converter={local:IntToStringConverter}, StringFormat='Value:{0}'}" />
        <TextBlock
            Width="300"
            Height="33"
            Margin="15,10"
            HorizontalAlignment="Left"
            Text="{Binding ElementName=NumberBox, Path=Value, Converter={x:Static local:MainWindowViewModel.NumberToStringConverter}, StringFormat='Value:{0}'}" />
        <ui:NumberBox
            Name="NumberBox"
            Width="300"
            Margin="15,10"
            HorizontalAlignment="Left" />
        <ui:Card Margin="15,10">
            <StackPanel>
                <ui:TextBlock FontTypography="Caption" Text="IMultiValueConverter的用法" />
                <Rectangle
                    x:Name="ColorBox"
                    Height="30"
                    Margin="15,10"
                    RadiusX="4"
                    RadiusY="4"
                    Stroke="Black">
                    <Rectangle.Fill>
                        <MultiBinding Converter="{StaticResource rgbConv}" Mode="TwoWay">
                            <Binding ElementName="sR" Path="Value" />
                            <Binding ElementName="sG" Path="Value" />
                            <Binding ElementName="sB" Path="Value" />
                        </MultiBinding>
                    </Rectangle.Fill>
                </Rectangle>
                <Slider
                    x:Name="sR"
                    Margin="15,10"
                    IsSnapToTickEnabled="True"
                    Maximum="255"
                    Minimum="0"
                    TickFrequency="1" />
                <Slider
                    x:Name="sG"
                    Margin="15,10"
                    IsSnapToTickEnabled="True"
                    Maximum="255"
                    Minimum="0"
                    TickFrequency="1" />
                <Slider
                    x:Name="sB"
                    Margin="15,10"
                    IsSnapToTickEnabled="True"
                    Maximum="255"
                    Minimum="0"
                    TickFrequency="1" />
            </StackPanel>
        </ui:Card>
    </StackPanel>
</ui:FluentWindow>
