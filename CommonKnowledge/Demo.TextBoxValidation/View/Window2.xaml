<Window
    x:Class="Demo.TextBoxValidation.Window2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Demo.TextBoxValidation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Window2"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Window.DataContext>
        <local:Window2ViewModel />
    </Window.DataContext>
    <StackPanel>
        <TextBlock Margin="5" Text="IDataError全局用法" />
        <TextBox Margin="5" Text="{Binding UserName, ValidatesOnDataErrors=True}" />
        <TextBox Margin="5" Text="{Binding Age, ValidatesOnDataErrors=True}" />
        <TextBlock
            Margin="5"
            Foreground="Red"
            Text="{Binding Error}" />
    </StackPanel>
</Window>
